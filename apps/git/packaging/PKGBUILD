# Local binary snapshot, staged and checksummed by build.sh after a locked Cargo build.
# This recipe packages the current checkout; it does not download an upstream release.
pkgname=nyx-git
pkgver=0.1.0
pkgrel=1
pkgdesc='Native GTK Git client for the Nyx Suite'
arch=('x86_64' 'aarch64')
url='https://github.com/design-nexus/nyx-git'
license=('MIT')
depends=('gtk4>=4.18' 'gtksourceview5' 'git' 'glib2' 'glibc' 'gcc-libs' 'pango' 'cairo' 'graphene' 'libsecret')
optdepends=('git-lfs: large-file storage controls' 'gnome-keyring: Secret Service provider credential storage' 'xdg-utils: open repositories in external applications')
options=('!strip' '!debug')
source=('nyx-git' 'io.github.design_nexus.nyx.Git.desktop'
        'io.github.design_nexus.nyx.Git.svg' 'LICENSE' 'README.md' 'PLAN.md')
# build.sh appends sha256sums for these exact local artifacts.

package() {
    install -Dm755 "$srcdir/nyx-git" "$pkgdir/usr/bin/nyx-git"
    install -Dm644 "$srcdir/io.github.design_nexus.nyx.Git.desktop" "$pkgdir/usr/share/applications/io.github.design_nexus.nyx.Git.desktop"
    install -Dm644 "$srcdir/io.github.design_nexus.nyx.Git.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/io.github.design_nexus.nyx.Git.svg"
    install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 "$srcdir/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 "$srcdir/PLAN.md" "$pkgdir/usr/share/doc/$pkgname/PLAN.md"
    install -Dm644 "$startdir/PKGBUILD" "$pkgdir/usr/share/doc/$pkgname/PKGBUILD"
}
